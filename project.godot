; Engine configuration file.
; 拓荒者之歌 Pioneer's Ballad

config_version=5

[application]

config/name="拓荒者之歌 Pioneer's Ballad"
config/description="一个原创的 2D 沙盒冒险游戏（开发中）。"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
; 存档文件夹固定用这个英文名（~/Library/Application Support/PioneersBallad），以后再改游戏名也不会丢存档
config/use_custom_user_dir=true
config/custom_user_dir_name="PioneersBallad"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.05, 1)
